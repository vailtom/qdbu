{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QDBU",
  "version": "0.1.0",
  "identifier": "br.projetos.qdbu",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "QDBU - Database Utility",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../bin/qdbudll.dll": "qdbudll.dll"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
